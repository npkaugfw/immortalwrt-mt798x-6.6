# 红米AX6000 110M分区 终极配置（padavanonly 24.10 官方适配）
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000=y

# 核心：启用hanwckf uboot 110M大分区支持
CONFIG_TARGET_MEDIATEK_FILOGIC_DEVICE_xiaomi_redmi-router-ax6000-uboot=y
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=78

# CPU性能优化（默认调度器更省电且性能不减）
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_ARM64_CRYPTO=y
CONFIG_CRYPTO_AES_ARM64=y
CONFIG_CRYPTO_SHA256_ARM64=y
CONFIG_CRYPTO_GHASH_ARM64=y

# 内存与存储优化
CONFIG_KERNEL_ZRAM=y
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_block-mount=y

# 网络核心优化（全锥NAT+BBR加速）
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_nft-fullcone=y
CONFIG_PACKAGE_irqbalance=y
CONFIG_PACKAGE_ethtool=y

# 无线驱动（闭源官方驱动，WiFi6性能最强）
CONFIG_PACKAGE_kmod-mt7986-wo=y
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_iw=y

# FanchmWrt应用过滤核心
CONFIG_PACKAGE_luci-app-fcm=y
CONFIG_PACKAGE_luci-i18n-fcm-zh-cn=y

# HomeProxy代理插件（支持所有主流协议）
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn=y
CONFIG_PACKAGE_homeproxy=y
CONFIG_PACKAGE_sing-box=y

# 节点小宝（一键订阅管理）
CONFIG_PACKAGE_luci-app-nodepawn=y
CONFIG_PACKAGE_luci-i18n-nodepawn-zh-cn=y

# 主题与界面
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# 常用网络工具
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_ddns-scripts-aliyun=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y

# 系统管理工具
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-i18n-commands-zh-cn=y

# 广告过滤与QoS
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-i18n-adguardhome-zh-cn=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y

# 关闭无用功能（减小固件体积）
# CONFIG_PACKAGE_luci-app-samba4 is not set
# CONFIG_PACKAGE_luci-app-ntpc is not set
# CONFIG_PACKAGE_luci-app-accesscontrol is not set
