# 红米AX6000 110M分区 最终配置（padavanonly 6.6内核）
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000=y

# 110M大分区核心配置
CONFIG_TARGET_MEDIATEK_FILOGIC_DEVICE_xiaomi_redmi-router-ax6000-uboot=y
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=78

# CPU与加密加速
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_ARM64_CRYPTO=y
CONFIG_CRYPTO_AES_ARM64=y
CONFIG_CRYPTO_SHA256_ARM64=y

# 网络核心优化
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_nft-fullcone=y
CONFIG_PACKAGE_irqbalance=y

# 闭源无线驱动（性能最强）
CONFIG_PACKAGE_kmod-mt7986-wo=y
CONFIG_PACKAGE_wpad-openssl=y

# 你需要的全部插件
CONFIG_PACKAGE_luci-app-fcm=y
CONFIG_PACKAGE_luci-i18n-fcm-zh-cn=y
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn=y
CONFIG_PACKAGE_luci-app-nodepawn=y
CONFIG_PACKAGE_luci-i18n-nodepawn-zh-cn=y

# 主题与常用工具
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-adguardhome=y
